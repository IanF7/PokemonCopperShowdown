#!/usr/bin/env node
/**
 * Sets the password for a trusted name (one with a rank in
 * config/usergroups.csv) on a self-hosted server with no login server.
 *
 *   node tools/set-password Starcrafter347
 *
 * Then log in from the chat box with: /trn Starcrafter347,0,yourpassword
 *
 * The password is stored hashed in config/trusted-passwords.json, which is
 * git-ignored: run this separately on each machine (your PC and the VM).
 * No restart needed.
 */
'use strict';

const crypto = require('crypto');
const fs = require('fs');
const path = require('path');
const readline = require('readline');

const FILE = path.resolve(__dirname, '../config/trusted-passwords.json');
const name = process.argv[2];
if (!name) {
	console.error('Usage: node tools/set-password [username]');
	process.exit(1);
}
const userid = name.toLowerCase().replace(/[^a-z0-9]+/g, '');

function ask(question) {
	const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
	return new Promise(resolve => rl.question(question, answer => {
		rl.close();
		resolve(answer);
	}));
}

(async () => {
	const password = (await ask(`New password for ${userid}: `)).trim();
	if (password.length < 8) {
		console.error('Please use at least 8 characters.');
		process.exit(1);
	}
	if (password.includes(';')) {
		console.error("Passwords can't contain ';'.");
		process.exit(1);
	}
	const passwords = fs.existsSync(FILE) ? JSON.parse(fs.readFileSync(FILE, 'utf8')) : {};
	const salt = crypto.randomBytes(16).toString('hex');
	passwords[userid] = `${salt}:${crypto.scryptSync(password, salt, 64).toString('hex')}`;
	fs.writeFileSync(FILE, JSON.stringify(passwords, null, '\t') + '\n');
	console.log(`Saved. Log in by typing in the chat box: /trn ${name},0,[your password]`);
})();
