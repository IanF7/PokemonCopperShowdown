#!/usr/bin/env node
/**
 * Server-owner tool for this server's own accounts (server/local-accounts.ts).
 * Use it to reset a player's forgotten password, create a staff account, or
 * delete an account. Players normally register from the client instead.
 *
 *   node tools/set-password [username]            set/reset a password
 *   node tools/set-password --delete [username]   delete an account
 *   node tools/set-password --list                list registered names
 *
 * Resetting a password also logs that account out everywhere. The password is
 * typed in hidden, not passed on the command line (which would save it in your
 * shell history). No server restart is needed.
 */
'use strict';

const path = require('path');
const readline = require('readline');

let LocalAccounts;
try {
	LocalAccounts = require(path.resolve(__dirname, '../dist/server/local-accounts'));
} catch {
	console.error('Build the server first: node build');
	process.exit(1);
}

let rl = null;
let currentQuestion = '';
let closed = false;
const pendingLines = [];
const waiting = [];
function askHidden(question) {
	if (!rl) {
		rl = readline.createInterface({ input: process.stdin, output: process.stdout, terminal: !!process.stdin.isTTY });
		// hide what's typed: only ever print the question itself
		rl._writeToOutput = text => {
			if (text.includes(currentQuestion)) rl.output.write(currentQuestion);
		};
		// queue lines, so input that arrives early (e.g. pasted) isn't lost
		rl.on('line', line => {
			const next = waiting.shift();
			if (next) next.resolve(line); else pendingLines.push(line);
		});
		rl.on('close', () => {
			closed = true;
			for (const next of waiting.splice(0)) next.reject(new Error('No password entered. Nothing was changed.'));
		});
	}
	currentQuestion = question;
	rl.setPrompt(question);
	rl.prompt();
	return new Promise((resolve, reject) => {
		const done = line => {
			rl.output.write('\n');
			resolve(line);
		};
		if (pendingLines.length) return done(pendingLines.shift());
		if (closed) return reject(new Error('No password entered. Nothing was changed.'));
		waiting.push({ resolve: done, reject });
	});
}

(async () => {
	const args = process.argv.slice(2);
	if (args[0] === '--list') {
		const fs = require('fs');
		const accounts = fs.existsSync(LocalAccounts.ACCOUNTS_FILE) ?
			JSON.parse(fs.readFileSync(LocalAccounts.ACCOUNTS_FILE, 'utf8') || '{}') : {};
		if (!Object.keys(accounts).length) console.log('No registered names yet.');
		for (const id in accounts) {
			console.log(`${accounts[id].name}  (registered ${new Date(accounts[id].created).toISOString().slice(0, 10)})`);
		}
		return;
	}
	if (args[0] === '--delete') {
		if (!args[1]) throw new Error('Usage: node tools/set-password --delete [username]');
		const existed = await LocalAccounts.remove(args[1]);
		console.log(existed ? `Deleted the account ${args[1]}.` : `${args[1]} isn't registered.`);
		return;
	}
	const name = args.join(' ').trim();
	if (!name || !/[a-zA-Z]/.test(name) || LocalAccounts.toID(name).length > 18) {
		throw new Error('Usage: node tools/set-password [username]  (up to 18 letters/numbers)');
	}
	const userid = LocalAccounts.toID(name);
	const existing = LocalAccounts.get(userid);
	const password = await askHidden(`${existing ? 'New' : 'Password for new account'} ${existing?.name || name} (hidden): `);
	const confirm = await askHidden('Type it again: ');
	rl.close();
	if (password !== confirm) throw new Error("The passwords don't match. Nothing was changed.");
	const problem = await LocalAccounts.checkNewPassword(password, userid);
	if (problem) throw new Error(problem);
	await LocalAccounts.setPassword(existing?.name || name, password);
	console.log(existing ?
		`Password changed for ${existing.name}, and it was logged out everywhere.` :
		`Created the account ${name}. Log in by choosing that name on the site.`);
})().catch(err => {
	console.error(err.message);
	process.exit(1);
});
