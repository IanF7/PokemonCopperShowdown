#!/usr/bin/env node
/**
 * Builds Random Battle sets for Pokemon that don't have any.
 *
 *   node tools/build-random-sets          add sets for anything missing
 *   node tools/build-random-sets --force  rebuild every generated set
 *
 * Pokemon Showdown ships hand-tuned sets for the Pokemon in Scarlet/Violet
 * (data/random-battles/gen9/sets.json and doubles-sets.json), but not for
 * Pokemon Copper's own Pokemon, or the older Pokemon this game brings back.
 * Without a set, a Pokemon simply never appears in a Random Battle.
 *
 * This fills the gaps: it picks a role from the Pokemon's stats and a movepool
 * from what it can actually learn, in the same format Showdown uses. Sets that
 * already exist are left alone, and generated ones are marked so they can be
 * rebuilt later ("generated": true).
 *
 * Mega Evolutions get a set of their own, built around the Mega's stats and
 * typing but keeping the base forme's ability, the way Showdown does it in
 * Gen 6 and 7. The team holds the base Pokemon and its stone, so it Mega
 * Evolves in battle rather than starting out Mega.
 *
 * Re-run it after adding new Pokemon or changing learnsets, then rebuild.
 */
'use strict';

const fs = require('fs');
const path = require('path');

const { Dex } = require(path.resolve(__dirname, '../dist/sim'));
const DATA_DIR = path.resolve(__dirname, '../data/random-battles/gen9');
const FORCE = process.argv.includes('--force');

/** moves that need a charge/recharge turn, hurt the user badly, or are too random to hand out */
const BAD_MOVES = new Set([
	'hyperbeam', 'gigaimpact', 'solarbeam', 'solarblade', 'skyattack', 'fly', 'dig', 'dive', 'bounce',
	'phantomforce', 'shadowforce', 'razorwind', 'skullbash', 'frenzyplant', 'blastburn', 'hydrocannon',
	'rockwrecker', 'roaroftime', 'prismaticlaser', 'eternabeam', 'meteorassault', 'lastresort', 'explosion',
	'selfdestruct', 'memento', 'finalgambit', 'healingwish', 'lunardance', 'mirrormove', 'naturepower',
	'metronome', 'assist', 'copycat', 'sleeptalk', 'snore', 'dreameater', 'synchronoise', 'present', 'beatup',
	'bide', 'counter', 'mirrorcoat', 'endeavor', 'falseswipe', 'holdback', 'guillotine', 'horndrill',
	'fissure', 'sheercold', 'splash', 'celebrate', 'happyhour', 'holdhands', 'teleport', 'transform',
	'bestow', 'skydrop', 'freezeshock', 'iceburn', 'dynamaxcannon', 'behemothblade', 'behemothbash',
	'steelbeam', 'mistyexplosion', 'chloroblast', 'shelltrap', 'focuspunch', 'beakblast', 'bellydrum',
]);
// setup moves, split so a physical attacker isn't handed Nasty Plot
const SETUP_PHYSICAL = [
	'swordsdance', 'dragondance', 'bulkup', 'shiftgear', 'victorydance', 'tidyup', 'coil', 'honeclaws', 'curse',
];
const SETUP_SPECIAL = ['nastyplot', 'calmmind', 'quiverdance', 'takeheart', 'clangoroussoul'];
const SETUP_NEUTRAL = ['shellsmash', 'workup', 'growth', 'irondefense', 'acidarmor', 'cosmicpower'];
/** all do the same thing, so a set never wants more than one */
const SETUP_SPEED = ['agility', 'rockpolish', 'autotomize'];
const RECOVERY_MOVES = [
	'recover', 'roost', 'softboiled', 'milkdrink', 'slackoff', 'synthesis', 'moonlight', 'morningsun',
	'shoreup', 'strengthsap', 'junglehealing', 'rest', 'painsplit',
];
const PIVOT_MOVES = ['uturn', 'voltswitch', 'flipturn', 'partingshot'];
const UTILITY_MOVES = [
	'knockoff', 'willowisp', 'thunderwave', 'taunt', 'toxic', 'substitute',
	'rapidspin', 'defog', 'encore', 'spore', 'sleeppowder', 'hypnosis', 'glare', 'nuzzle', 'yawn',
	'leechseed', 'wish', 'trick', 'switcheroo', 'haze', 'destinybond',
	'courtchange', 'healbell', 'aromatherapy', 'roar', 'whirlwind', 'tailwind', 'trickroom',
	'lightscreen', 'reflect', 'auroraveil',
];
/** only worth a slot on something that expects to switch in and out */
const HAZARD_MOVES = ['stealthrock', 'spikes', 'toxicspikes', 'stickyweb'];
/** the only support a sweeper benefits from: everything else costs it a turn */
const SWEEPER_UTILITY = ['substitute', 'taunt', 'knockoff', 'encore', 'trick', 'switcheroo'];
/**
 * Dead weight on most Pokemon, since you have to be hit first and live through it --
 * but they're the entire point of something with a huge HP stat and no offence at all,
 * which is how Wobbuffet is meant to be played.
 */
const COUNTER_MOVES = ['counter', 'mirrorcoat'];
const wantsCounterMoves = species =>
	species.baseStats.hp >= 150 && Math.max(species.baseStats.atk, species.baseStats.spa) <= 50;
const DOUBLES_MOVES = [
	'fakeout', 'followme', 'ragepowder', 'helpinghand', 'icywind', 'electroweb', 'snarl', 'wideguard',
	'quickguard', 'decorate', 'tailwind', 'trickroom',
];
/** abilities that are actively bad to be handed at random */
const BAD_ABILITIES = new Set([
	'defeatist', 'slowstart', 'truant', 'stall', 'klutz', 'normalize', 'illuminate', 'runaway',
	'honeygather', 'pickup', 'ballfetch', 'wimpout', 'emergencyexit', 'zenmode', 'schooling', 'iceface',
	'hungerswitch', 'powerconstruct', 'battlebond', 'disguise', 'rkssystem', 'multitype', 'forecast',
	'stancechange', 'shieldsdown', 'zerotohero', 'commander', 'flowergift', 'imposter', 'ripen',
]);

/**
 * The forme a Mega is sent out as, or null if holding the stone wouldn't actually
 * produce this Mega. Mirrors BattleActions#canMegaEvo, so a Mega is only ever
 * generated if the battle engine really turns that Pokemon into it: Mega Rayquaza
 * needs a move rather than a stone, Mega Zygarde comes from a forme that can't be
 * sent out, and Meowstic-F holding its stone turns into the male Mega, not the female one.
 */
const megaBaseOf = species => {
	if (!species.isMega || !species.requiredItem) return null;
	if (typeof species.battleOnly !== 'string') return null;
	const base = Dex.species.get(species.battleOnly);
	const stone = Dex.items.get(species.requiredItem);
	if (!base.exists || !stone.megaStone) return null;
	let target = stone.megaStone[base.name];
	if (!target || Dex.species.get(target).gen < 9) {
		target = stone.megaStone[base.baseSpecies];
		if (target === base.name) target = null;
	}
	return Dex.species.get(target || '').id === species.id ? base : null;
};
const isMega = species => !!megaBaseOf(species);

const bst = species => Object.values(species.baseStats).reduce((a, b) => a + b, 0);
/** Showdown scales levels down as Pokemon get stronger; this matches its own curve closely */
const levelFor = species => Math.max(70, Math.min(95, Math.round(91 - (bst(species) - 400) * 0.064)));

const moveScore = move => {
	let power = move.basePower;
	if (move.multihit) power *= Array.isArray(move.multihit) ? 3 : move.multihit;
	if (move.id === 'return' || move.id === 'frustration') power = 100;
	const accuracy = move.accuracy === true ? 100 : move.accuracy;
	return power * (accuracy / 100);
};

function movesFor(species) {
	const pool = [...Dex.species.getMovePool(species.id)].map(id => Dex.moves.get(id))
		.filter(move => move.exists && !move.isNonstandard && !move.isZ && !move.isMax &&
			(!BAD_MOVES.has(move.id) || (COUNTER_MOVES.includes(move.id) && wantsCounterMoves(species))));
	const { atk, spa } = species.baseStats;
	// Commit to one attacking category. Mixing physical and special attacks is what let
	// a four-move draw come out as Swords Dance alongside Ice Beam: the setup move and
	// the attacks have to agree or half the set is dead weight.
	let category;
	if (atk > spa + 10) category = 'Physical';
	else if (spa > atk + 10) category = 'Special';
	else {
		// evenly spread stats: go with whichever side it actually has the moves for
		const strength = cat => pool.filter(m => m.category === cat && m.basePower >= 60)
			.sort((a, b) => moveScore(b) - moveScore(a)).slice(0, 4)
			.reduce((total, m) => total + moveScore(m), 0);
		category = strength('Physical') >= strength('Special') ? 'Physical' : 'Special';
	}
	const attacks = pool.filter(m => m.category === category && m.basePower >= 55)
		.sort((a, b) => moveScore(b) - moveScore(a));
	return { pool, attacks, category };
}

/**
 * What kind of Pokemon this is, decided from its stats alone. Working this out first
 * is what keeps a set coherent: the archetype says how many slots go to attacks,
 * setup, recovery and support, instead of bolting one of each onto every Pokemon.
 */
function archetypeFor(species) {
	const { hp, atk, def, spa, spd, spe } = species.baseStats;
	const offense = Math.max(atk, spa);
	const bulk = hp + def + spd;
	if (spe >= 95 && offense >= 95) return 'sweeper';
	if (offense >= 110) return 'wallbreaker';
	if (bulk >= 280 && offense >= 85) return 'bulky attacker';
	if (bulk >= 280) return 'bulky support';
	if (spe >= 95) return 'fast support';
	return 'bulky attacker';
}

/** how many of each kind of move each archetype wants */
const QUOTAS = {
	'sweeper': { attacks: 4, setup: 2, recovery: 0, utility: 1, pivot: 0, hazards: 0 },
	'wallbreaker': { attacks: 4, setup: 1, recovery: 1, utility: 1, pivot: 1, hazards: 0 },
	'bulky attacker': { attacks: 3, setup: 1, recovery: 1, utility: 1, pivot: 1, hazards: 1 },
	'bulky support': { attacks: 2, setup: 0, recovery: 1, utility: 3, pivot: 1, hazards: 1 },
	'fast support': { attacks: 3, setup: 0, recovery: 1, utility: 2, pivot: 1, hazards: 1 },
};

function buildMovepool(species, isDoubles) {
	const { pool, attacks, category } = movesFor(species);
	const archetype = archetypeFor(species);
	const quota = QUOTAS[archetype];
	const has = id => pool.some(m => m.id === id);
	const chosen = [];
	const add = move => {
		if (move && !chosen.includes(move.name) && chosen.length < 9) chosen.push(move.name);
	};
	const pick = preferred => preferred.filter(id => has(id)).map(id => Dex.moves.get(id).name);

	// STAB first, then one move per new type for coverage, up to this archetype's quota
	for (const type of species.types) add(attacks.find(m => m.type === type));
	const usedTypes = new Set(species.types);
	for (const move of attacks) {
		if (chosen.length >= quota.attacks) break;
		if (usedTypes.has(move.type)) continue;
		usedTypes.add(move.type);
		add(move);
	}
	// top up so a four-move draw can't come out as one attack and three status moves
	for (const move of attacks) {
		if (chosen.length >= Math.min(quota.attacks, 3)) break;
		add(move);
	}
	const attackCount = chosen.length;

	const offensiveSetup = pick([...(category === 'Physical' ? SETUP_PHYSICAL : SETUP_SPECIAL), ...SETUP_NEUTRAL]);
	const speedSetup = pick(SETUP_SPEED);
	// a second setup move is only worth it if it does something different, so pair an
	// offensive boost with a speed boost rather than handing out Agility and Rock Polish
	const setup = quota.setup >= 2 ?
		[...offensiveSetup.slice(0, 1), ...speedSetup.slice(0, 1)] :
		[...offensiveSetup, ...speedSetup];
	const recovery = pick(RECOVERY_MOVES);
	const pivot = pick(PIVOT_MOVES);
	// a bulky attacker that found setup gets labelled a sweeper too, so judge by what
	// the set will actually be rather than by the archetype alone
	const willSweep = archetype === 'sweeper' ||
		(archetype === 'bulky attacker' && setup.length && species.baseStats.spe >= 85);
	const utilityList = willSweep ? SWEEPER_UTILITY : UTILITY_MOVES;
	const utility = pick(wantsCounterMoves(species) ? [...COUNTER_MOVES, ...utilityList] : utilityList);
	const hazards = pick(HAZARD_MOVES);

	if (isDoubles) {
		if (has('protect')) add(Dex.moves.get('protect'));
		for (const name of pick(DOUBLES_MOVES).slice(0, 2)) add(Dex.moves.get(name));
	}
	for (const name of setup.slice(0, quota.setup)) add(Dex.moves.get(name));
	// Rest is fine on its own here: Showdown gives it a Chesto Berry, and pairs it
	// with Sleep Talk when the Pokemon has one
	if (quota.recovery && has('sleeptalk') && recovery.includes('Rest')) add(Dex.moves.get('sleeptalk'));
	for (const name of recovery.slice(0, quota.recovery)) add(Dex.moves.get(name));
	for (const name of pivot.slice(0, quota.pivot)) add(Dex.moves.get(name));
	for (const name of hazards.slice(0, quota.hazards)) add(Dex.moves.get(name));
	for (const name of utility.slice(0, quota.utility)) add(Dex.moves.get(name));
	// Showdown picks four moves, so make sure there are at least four to pick from
	for (const name of [...utility, ...pick(UTILITY_MOVES), ...pick(HAZARD_MOVES)]) {
		if (chosen.length >= 4) break;
		add(Dex.moves.get(name));
	}

	return {
		movepool: chosen, attackCount, category, archetype,
		hasSetup: chosen.some(n => setup.includes(n)),
		hasRecovery: chosen.some(n => recovery.includes(n)),
		hasProtect: has('protect'),
	};
}

function roleFor(species, info, isDoubles) {
	const { atk, def, spa, spd, hp, spe } = species.baseStats;
	const offense = Math.max(atk, spa);
	const bulk = hp + def + spd;
	if (isDoubles) {
		if (info.hasProtect && offense >= 100) return 'Offensive Protect';
		if (info.hasProtect && bulk >= 270) return 'Bulky Protect';
		if (spe >= 95 && offense >= 95) return 'Doubles Fast Attacker';
		if (bulk >= 260 && offense >= 85) return 'Doubles Bulky Attacker';
		if (info.hasSetup) return 'Doubles Setup Sweeper';
		if (offense >= 110) return 'Doubles Wallbreaker';
		return 'Doubles Support';
	}
	switch (info.archetype) {
	case 'sweeper': return info.hasSetup ? 'Setup Sweeper' : 'Fast Attacker';
	case 'wallbreaker': return 'Wallbreaker';
	case 'bulky attacker': return info.hasSetup && spe >= 85 ? 'Setup Sweeper' : 'Bulky Attacker';
	case 'fast support': return 'Fast Support';
	default: return 'Bulky Support';
	}
}

function abilitiesFor(species) {
	const abilities = Object.values(species.abilities)
		.filter(name => name && !BAD_ABILITIES.has(Dex.toID(name)));
	return abilities.length ? abilities : [Object.values(species.abilities)[0]];
}

function generate(species, isDoubles) {
	const info = buildMovepool(species, isDoubles);
	// Showdown picks four moves from this pool, so anything that can't fill four
	// (Wobbuffet, whose only attacks are Counter and Mirror Coat) is left out entirely
	if (info.movepool.length < 4) return null;
	// A Mega starts the battle in its base forme, so it carries the base forme's ability
	const abilitySource = megaBaseOf(species) || species;
	return {
		role: roleFor(species, info, isDoubles),
		movepool: info.movepool.sort(),
		abilities: abilitiesFor(abilitySource),
		teraTypes: [...new Set(species.types)],
	};
}

function build(file, isDoubles) {
	const filePath = path.join(DATA_DIR, file);
	const data = JSON.parse(fs.readFileSync(filePath, 'utf8'));
	let added = 0, rebuilt = 0, skipped = 0;

	// Showdown's own sets are fully evolved Pokemon (plus a handful of Eviolite
	// users it picked by hand), so generated ones follow the same rule: a Random
	// Battle full of Caterpies isn't much of a battle.
	// Totem and costume formes are near-duplicates of the ordinary Pokemon, so
	// leaving them in would just mean seeing the same Pokemon twice as often
	const DUPLICATE_FORMES = /-(Totem|Cosplay|Belle|Libre|PhD|Pop-Star|Rock-Star|Spiky-eared|Starter)/i;
	const eligible = species => {
		if (!species.exists || species.isNonstandard) return false;
		if (species.forme === 'Gmax' || DUPLICATE_FORMES.test(species.name)) return false;
		if (!Dex.species.getMovePool(species.id).size) return false;
		// Megas get a set of their own, built around the Mega's stats and typing, the
		// way Showdown does it in Gen 6 and 7. The team still holds the base Pokemon;
		// the stone comes along with it, so it Mega Evolves in battle.
		if (isMega(species)) return eligible(megaBaseOf(species));
		if (species.isMega || species.battleOnly) return false;
		return !species.evos?.length;
	};

	// drop generated sets for anything that no longer qualifies
	for (const id of Object.keys(data)) {
		if (data[id]?.generated && !eligible(Dex.species.get(id))) delete data[id];
	}

	for (const species of Dex.species.all()) {
		if (!eligible(species)) continue;
		const existing = data[species.id];
		if (existing && !(FORCE && existing.generated)) continue;

		const set = generate(species, isDoubles);
		if (!set) {
			// drop any entry we wrote for it previously, or a stale one keeps it in the pool
			if (existing?.generated) delete data[species.id];
			skipped++;
			continue;
		}
		if (existing) rebuilt++; else added++;
		data[species.id] = { level: levelFor(species), sets: [set], generated: true };
	}

	// keep the file in species order, like the originals
	const ordered = {};
	for (const id of Object.keys(data).sort((a, b) => (Dex.species.get(a).num - Dex.species.get(b).num) || a.localeCompare(b))) {
		ordered[id] = data[id];
	}
	fs.writeFileSync(filePath, JSON.stringify(ordered, null, '\t') + '\n');
	console.log(`${file}: ${added} added, ${rebuilt} rebuilt, ${skipped} skipped (no usable moves), ${Object.keys(ordered).length} total`);
}

build('sets.json', false);
build('doubles-sets.json', true);
