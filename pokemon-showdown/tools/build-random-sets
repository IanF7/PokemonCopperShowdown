#!/usr/bin/env node
/**
 * Builds Random Battle sets for Pokemon that don't have any.
 *
 *   node tools/build-random-sets          add sets for anything missing
 *   node tools/build-random-sets --force  rebuild every generated set
 *
 * Pokemon Showdown ships hand-tuned sets for the Pokemon in Scarlet/Violet
 * (data/random-battles/gen9/sets.json and doubles-sets.json), but not for
 * Pokemon Copper's own Pokemon, or the older Pokemon this game brings back.
 * Without a set, a Pokemon simply never appears in a Random Battle.
 *
 * This fills the gaps: it picks a role from the Pokemon's stats and a movepool
 * from what it can actually learn, in the same format Showdown uses. Sets that
 * already exist are left alone, and generated ones are marked so they can be
 * rebuilt later ("generated": true).
 *
 * Mega Evolutions get a set of their own, built around the Mega's stats and
 * typing but keeping the base forme's ability, the way Showdown does it in
 * Gen 6 and 7. The team holds the base Pokemon and its stone, so it Mega
 * Evolves in battle rather than starting out Mega.
 *
 * Every set gets an attack of each of its types first, sticks to the attacking side
 * its stats favour, then picks coverage by what it fixes. A Pokemon whose abilities
 * all need a weather or terrain carries the move that sets it, and formes that only
 * look different (Minior's cores, Vivillon's patterns) share a single set.
 *
 * Re-run it after adding new Pokemon or changing learnsets, then rebuild.
 */
'use strict';

const fs = require('fs');
const path = require('path');

const { Dex } = require(path.resolve(__dirname, '../dist/sim'));
const DATA_DIR = path.resolve(__dirname, '../data/random-battles/gen9');
const FORCE = process.argv.includes('--force');

/** moves that need a charge/recharge turn, hurt the user badly, or are too random to hand out */
const BAD_MOVES = new Set([
	'hyperbeam', 'gigaimpact', 'solarbeam', 'solarblade', 'skyattack', 'fly', 'dig', 'dive', 'bounce',
	'phantomforce', 'shadowforce', 'razorwind', 'skullbash', 'frenzyplant', 'blastburn', 'hydrocannon',
	'rockwrecker', 'roaroftime', 'prismaticlaser', 'eternabeam', 'meteorassault', 'lastresort', 'explosion',
	'selfdestruct', 'memento', 'finalgambit', 'healingwish', 'lunardance', 'mirrormove', 'naturepower',
	'metronome', 'assist', 'copycat', 'sleeptalk', 'snore', 'dreameater', 'synchronoise', 'present', 'beatup',
	'bide', 'counter', 'mirrorcoat', 'endeavor', 'falseswipe', 'holdback', 'guillotine', 'horndrill',
	'fissure', 'sheercold', 'splash', 'celebrate', 'happyhour', 'holdhands', 'teleport', 'transform',
	'bestow', 'skydrop', 'freezeshock', 'iceburn', 'dynamaxcannon', 'behemothblade', 'behemothbash',
	'steelbeam', 'mistyexplosion', 'chloroblast', 'shelltrap', 'focuspunch', 'beakblast', 'bellydrum',
	// unreliable or conditional: random type, needs a Berry, needs terrain, a delayed hit, or lock-ins
	// that a coverage slot shouldn't be spent on (Outrage stays, but only as a Dragon's own STAB)
	'hiddenpower', 'belch', 'steelroller', 'futuresight', 'doomdesire', 'uproar', 'thrash', 'petaldance',
	'weatherball', 'retaliate', 'return', 'frustration', 'naturalgift', 'fling', 'spitup', 'rollout',
	'iceball', 'echoedvoice', 'round', 'chipaway', 'synchronoise', 'lastrespects',
]);
/**
 * Moves Showdown's team builder doesn't count as STAB (data/random-battles/gen9/teams.ts
 * NO_STAB): priority, pivots, chip and situational moves. A set's guaranteed attack of each
 * type has to be a real one, or the builder treats the type as uncovered and drops the move.
 */
const NO_STAB = new Set([
	'acidspray', 'accelerock', 'aquajet', 'bounce', 'breakingswipe', 'bulletpunch', 'chatter', 'chloroblast', 'clearsmog',
	'covet', 'dragontail', 'doomdesire', 'electroweb', 'eruption', 'explosion', 'fakeout', 'feint', 'flamecharge',
	'flipturn', 'futuresight', 'grassyglide', 'iceshard', 'icywind', 'incinerate', 'infestation', 'machpunch',
	'meteorbeam', 'mortalspin', 'nuzzle', 'pluck', 'pursuit', 'quickattack', 'rapidspin', 'reversal', 'selfdestruct',
	'shadowsneak', 'skydrop', 'snarl', 'strugglebug', 'suckerpunch', 'trailblaze', 'uturn', 'vacuumwave', 'voltswitch',
	'watershuriken', 'waterspout',
]);
/** lock-in moves: fine as a Dragon's STAB, a waste of a coverage slot on anything else */
const LOCK_IN_MOVES = ['outrage', 'ragingfury'];
// setup moves, split so a physical attacker isn't handed Nasty Plot
const SETUP_PHYSICAL = [
	'swordsdance', 'dragondance', 'bulkup', 'shiftgear', 'victorydance', 'tidyup', 'coil', 'honeclaws', 'curse',
];
const SETUP_SPECIAL = ['nastyplot', 'calmmind', 'quiverdance', 'takeheart', 'clangoroussoul'];
const SETUP_NEUTRAL = ['shellsmash', 'workup', 'growth', 'irondefense', 'acidarmor', 'cosmicpower'];
/** all do the same thing, so a set never wants more than one */
const SETUP_SPEED = ['agility', 'rockpolish', 'autotomize'];
const RECOVERY_MOVES = [
	'recover', 'roost', 'softboiled', 'milkdrink', 'slackoff', 'synthesis', 'moonlight', 'morningsun',
	'shoreup', 'strengthsap', 'junglehealing', 'rest', 'painsplit',
];
const PIVOT_MOVES = ['uturn', 'voltswitch', 'flipturn', 'partingshot'];
const UTILITY_MOVES = [
	'knockoff', 'willowisp', 'thunderwave', 'taunt', 'toxic', 'substitute',
	'rapidspin', 'defog', 'encore', 'spore', 'sleeppowder', 'hypnosis', 'glare', 'nuzzle', 'yawn',
	'leechseed', 'wish', 'trick', 'switcheroo', 'haze', 'destinybond',
	'courtchange', 'healbell', 'aromatherapy', 'roar', 'whirlwind', 'tailwind', 'trickroom',
	'lightscreen', 'reflect', 'auroraveil',
];
/** only worth a slot on something that expects to switch in and out */
const HAZARD_MOVES = ['stealthrock', 'spikes', 'toxicspikes', 'stickyweb'];
/** the only support a sweeper benefits from: everything else costs it a turn */
const SWEEPER_UTILITY = ['substitute', 'taunt', 'knockoff', 'encore', 'trick', 'switcheroo'];
/**
 * Dead weight on most Pokemon, since you have to be hit first and live through it --
 * but they're the entire point of something with a huge HP stat and no offence at all,
 * which is how Wobbuffet is meant to be played.
 */
const COUNTER_MOVES = ['counter', 'mirrorcoat'];
const wantsCounterMoves = species =>
	species.baseStats.hp >= 150 && Math.max(species.baseStats.atk, species.baseStats.spa) <= 50;
const DOUBLES_MOVES = [
	'fakeout', 'followme', 'ragepowder', 'helpinghand', 'icywind', 'electroweb', 'snarl', 'wideguard',
	'quickguard', 'decorate', 'tailwind', 'trickroom',
];
/** abilities that are actively bad to be handed at random */
const BAD_ABILITIES = new Set([
	'defeatist', 'slowstart', 'truant', 'stall', 'klutz', 'normalize', 'illuminate', 'runaway',
	'honeygather', 'pickup', 'ballfetch', 'wimpout', 'emergencyexit', 'zenmode', 'schooling', 'iceface',
	'hungerswitch', 'powerconstruct', 'battlebond', 'disguise', 'rkssystem', 'multitype', 'forecast',
	'stancechange', 'shieldsdown', 'zerotohero', 'commander', 'flowergift', 'imposter', 'ripen',
]);

/**
 * Abilities that do nothing until a weather or terrain is up. A Pokemon whose every
 * ability is one of these is dead weight without the matching move, so it always
 * carries it (Brawnsoon, for one, can't even reach its Flood forme without rain).
 */
const ABILITY_NEEDS = {
	swiftswim: 'raindance', raindish: 'raindance', hydration: 'raindance', stormsurge: 'raindance',
	chlorophyll: 'sunnyday', solarpower: 'sunnyday', leafguard: 'sunnyday', eternalflame: 'sunnyday',
	sandrush: 'sandstorm', sandforce: 'sandstorm', sandveil: 'sandstorm',
	slushrush: 'snowscape', icebody: 'snowscape', snowcloak: 'snowscape',
	surgesurfer: 'electricterrain', grasspelt: 'grassyterrain',
};
/**
 * Pokemon that fight in a different forme from the one they're sent out in. Their set
 * is built around the forme they actually battle in, and they carry what triggers it.
 */
const BATTLE_FORMES = {
	brawnsoon: 'Brawnsoon-Flood',
	// attacks in Blade Forme, and King's Shield (below) takes it back to Shield Forme
	aegislash: 'Aegislash-Blade',
	// School Forme for as long as it stays above a quarter of its HP
	wishiwashi: 'Wishiwashi-School',
};

/**
 * Abilities that make some moves much better than others. Each scores a move (how much
 * the ability multiplies its power); a set built around one is locked to that ability,
 * since the team builder would otherwise be free to hand out a different one and leave
 * the moves stranded. (A Mega always has its own ability, so it's built around that.)
 */
const ABILITY_BOOSTS = {
	technician: m => (m.basePower <= 60 ? 1.5 : 1),
	skilllink: m => (Array.isArray(m.multihit) ? 5 / 3 : 1),
	ironfist: m => (m.flags.punch ? 1.2 : 1),
	strongjaw: m => (m.flags.bite ? 1.5 : 1),
	sharpness: m => (m.flags.slicing ? 1.5 : 1),
	megalauncher: m => (m.flags.pulse ? 1.5 : 1),
	toughclaws: m => (m.flags.contact ? 1.3 : 1),
	reckless: m => (m.recoil || m.hasCrashDamage ? 1.2 : 1),
	sheerforce: m => (m.secondary || m.secondaries ? 1.3 : 1),
	punkrock: m => (m.flags.sound ? 1.3 : 1),
	steelworker: m => (m.type === 'Steel' ? 1.5 : 1),
	steelyspirit: m => (m.type === 'Steel' ? 1.5 : 1),
	serenegrace: m => (m.secondary?.chance ? 1.25 : 1),
	superluck: m => (m.critRatio >= 2 ? 1.3 : 1),
	sniper: m => (m.critRatio >= 2 ? 1.3 : 1),
	// Contrary turns Overheat and Superpower into boosting moves
	contrary: m => (selfDrop(m) ? 1.5 : 1),
	// (No Guard's real effect is that everything hits; this only marks the moves it helps)
	noguard: m => (typeof m.accuracy === 'number' && m.accuracy < 100 ? 1.001 : 1),
	electricsurge: m => (m.id === 'risingvoltage' ? 2 : 1),
	psychicsurge: m => (m.id === 'expandingforce' ? 1.5 : 1),
};
/** abilities that turn Normal-type moves into another type (Spectralize is Pokemon Copper's) */
const ATE_ABILITIES = {
	pixilate: 'Fairy', aerilate: 'Flying', refrigerate: 'Ice', galvanize: 'Electric', spectralize: 'Ghost',
};
/** abilities that double Attack: the set is physical whatever the stats say */
const ATTACK_DOUBLERS = ['hugepower', 'purepower'];
/** abilities worth building a set around for what they do, not for which moves they boost */
const PLAYSTYLE_ABILITIES = ['speedboost', 'prankster', 'gorillatactics'];
/** abilities that only pay off once the foe is poisoned, so they're the plan if it can learn Toxic */
const POISON_ABILITIES = ['merciless', 'corrosion'];
/**
 * Moves an ability needs to do its job: Speed Boost wants a free turn behind Protect,
 * Aegislash can't get back to its Shield Forme without King's Shield, Castform's Weather
 * Ball is what Forecast is for, and Merciless and Corrosion work off poisoning the foe.
 */
const ABILITY_MOVES = {
	speedboost: 'protect', stancechange: 'kingsshield', forecast: 'weatherball', merciless: 'toxic', corrosion: 'toxic',
};
/** status moves that are worth going first with Prankster */
const PRANKSTER_MOVES = [
	'willowisp', 'thunderwave', 'taunt', 'encore', 'substitute', 'destinybond', 'partingshot', 'glare', 'yawn',
	'leechseed', 'haze', 'reflect', 'lightscreen', 'toxic',
];
/** moves that cost HP, which a Pokemon with 1 HP (Shedinja) can't spare */
const costsHP = m => !!(m.recoil || m.hasCrashDamage || m.mindBlownRecoil || m.struggleRecoil ||
	['substitute', 'painsplit', 'bellydrum', 'curse', 'clangoroussoul', 'filletaway', 'shedtail'].includes(m.id));

/**
 * Sets written by hand, for Pokemon whose gimmick the rules above can't express.
 * Both singles and doubles use them; doubles adds Protect.
 */
const HAND_SETS = {
	// Forecast makes Castform Water-type in rain, which also makes Thunder and Hurricane sure hits
	castform: {
		role: 'Wallbreaker', abilities: ['Forecast'],
		movepool: ['Hurricane', 'Ice Beam', 'Rain Dance', 'Thunder', 'Weather Ball'],
	},
	// Flower Gift raises its Attack and Sp. Def in sun, where Solar Blade needs no charge turn
	cherrim: {
		role: 'Setup Sweeper', abilities: ['Flower Gift'],
		movepool: ['Play Rough', 'Solar Blade', 'Sunny Day', 'Swords Dance', 'Synthesis'],
	},
	// State Shift swaps it at random between a physical Normal forme and a special Ghost one,
	// so it gets an attack for each, plus Foul Play, which works the same either way
	puradox: {
		role: 'Bulky Support', abilities: ['State Shift'],
		movepool: ['Crush Claw', 'Encore', 'Foul Play', 'Parting Shot', 'Shadow Ball', 'Taunt'],
	},
};
/**
 * Pokemon whose stats sit too close together to pick an attacking side from, where the
 * movepool alone would pick the wrong one.
 */
const CATEGORY_OVERRIDES = {
	froslass: 'Special',
};
/** the attacking stat this move lowers on its user, if any */
const selfDrop = move => {
	const boosts = move.self?.boosts || move.selfBoost?.boosts || {};
	return (boosts.atk < 0 && move.category === 'Physical') || (boosts.spa < 0 && move.category === 'Special');
};
const TYPES = Dex.types.names().filter(type => type !== 'Stellar');
/** how well a set of attacking types hits every single type, so coverage can be scored */
const coverageScore = moveTypes => {
	let total = 0;
	for (const defender of TYPES) {
		let best = 0;
		for (const type of moveTypes) {
			if (!Dex.getImmunity(type, defender)) continue;
			best = Math.max(best, 2 ** Dex.getEffectiveness(type, defender));
		}
		// resisted-by-everything is what hurts most, so reward fixing that first
		total += best >= 2 ? 3 : best >= 1 ? 2 : best > 0 ? 0.5 : 0;
	}
	return total;
};

/**
 * The forme a Mega is sent out as, or null if holding the stone wouldn't actually
 * produce this Mega. Mirrors BattleActions#canMegaEvo, so a Mega is only ever
 * generated if the battle engine really turns that Pokemon into it: Mega Rayquaza
 * needs a move rather than a stone, Mega Zygarde comes from a forme that can't be
 * sent out, and Meowstic-F holding its stone turns into the male Mega, not the female one.
 */
const megaBaseOf = species => {
	if (!species.isMega || !species.requiredItem) return null;
	if (typeof species.battleOnly !== 'string') return null;
	const base = Dex.species.get(species.battleOnly);
	const stone = Dex.items.get(species.requiredItem);
	if (!base.exists || !stone.megaStone) return null;
	let target = stone.megaStone[base.name];
	if (!target || Dex.species.get(target).gen < 9) {
		target = stone.megaStone[base.baseSpecies];
		if (target === base.name) target = null;
	}
	return Dex.species.get(target || '').id === species.id ? base : null;
};
const isMega = species => !!megaBaseOf(species);

const bst = species => Object.values(battleStats(species)).reduce((a, b) => a + b, 0);
/** Showdown scales levels down as Pokemon get stronger; this matches its own curve closely */
const levelFor = species => Math.max(70, Math.min(95, Math.round(91 - (bst(species) - 400) * 0.064)));

const moveScore = (move, species, isDoubles = false) => {
	let power = move.basePower * (move.abilityBoost || 1);
	// Foul Play hits with the target's Attack, which is only a bargain for something weak
	if (move.id === 'foulplay' && species && battleStats(species).atk >= 100) power = 60;
	// in doubles, hitting both foes at once is worth more than a little extra power
	if (isDoubles && ['allAdjacentFoes', 'allAdjacent'].includes(move.target)) power *= 1.2;
	if (move.multihit) power *= Array.isArray(move.multihit) ? 3 : move.multihit;
	if (move.id === 'return' || move.id === 'frustration') power = 100;
	const accuracy = move.accuracy === true || move.alwaysHits ? 100 : move.accuracy;
	return power * (accuracy / 100);
};

/**
 * Pokemon that gained a new evolution in Pokemon Copper but are still worth a set of
 * their own: they can now hold Eviolite, which the team builder gives anything not fully
 * evolved. (Zebstrika and Lanturn are kept the same way, through Showdown's own sets.)
 */
const STILL_EVOLVING = ['dubwool'];

/** the stats a Pokemon actually battles with (see BATTLE_FORMES) */
const battleStats = species => (BATTLE_FORMES[species.id] ? Dex.species.get(BATTLE_FORMES[species.id]) : species).baseStats;

/**
 * The ability a set is built around, if one of the Pokemon's abilities changes which moves
 * it should use. A Mega's is fixed (its own); otherwise the ability that improves the most
 * of its attacks wins, provided it improves at least two of them.
 */
function abilityPlanFor(species) {
	const isMegaForme = !!megaBaseOf(species);
	const options = isMegaForme ? Object.values(species.abilities) : abilitiesFor(species);
	const learnable = [...Dex.species.getMovePool(species.id)].map(id => Dex.moves.get(id))
		.filter(m => m.exists && !m.isNonstandard && m.category !== 'Status' && m.basePower >= 40 && !BAD_MOVES.has(m.id));
	// how hard the Pokemon's four best attacks hit, used as-is or under a given ability
	const { atk, spa } = battleStats(species);
	const topFour = plan => learnable.map(m => asUsedBy(m, plan))
		.map(m => moveScore(m, species) * (m.category === 'Physical' ? atk : spa) *
			(species.types.includes(m.type) ? 1.5 : 1))
		.sort((a, b) => b - a).slice(0, 4).reduce((a, b) => a + b, 0);
	const baseline = topFour(null) || 1;
	let bestPlan = null, bestValue = 0;
	for (const name of options) {
		const id = Dex.toID(name);
		let value = 0;
		if (ATTACK_DOUBLERS.includes(id) || PLAYSTYLE_ABILITIES.includes(id)) {
			value = 99;
		} else if (POISON_ABILITIES.includes(id)) {
			value = Dex.species.getMovePool(species.id).has('toxic') ? 98 : 0;
		} else if (ATE_ABILITIES[id] || ABILITY_BOOSTS[id]) {
			// worth building around only if it makes the set hit noticeably harder
			const gain = topFour({ id }) / baseline;
			value = gain >= (isMegaForme ? 1.01 : 1.08) ? gain : 0;
			if (id === 'noguard') value = learnable.some(m => typeof m.accuracy === 'number' && m.accuracy <= 80) ? 1.5 : 0;
		}
		if (value > bestValue) {
			bestValue = value;
			bestPlan = name;
		}
	}
	// Abilities that must be built around even though they boost nothing (Stance Change,
	// Forecast): when it's the only ability there is, it's the plan
	if (!bestPlan && options.length === 1 && ABILITY_MOVES[Dex.toID(options[0])]) bestPlan = options[0];
	return bestPlan && { name: bestPlan, id: Dex.toID(bestPlan), fixed: isMegaForme };
}

/** the move as this Pokemon would actually use it: an -ate ability's type, the ability's boost */
function asUsedBy(move, plan) {
	if (!plan || move.category === 'Status') return move;
	const ate = ATE_ABILITIES[plan.id];
	// (Dex moves are frozen, so the changes go on a wrapper that inherits everything else)
	const wrap = props => Object.create(move, Object.fromEntries(
		Object.entries(props).map(([key, value]) => [key, { value, enumerable: true }])));
	if (ate && move.type === 'Normal') return wrap({ type: ate, abilityBoost: 1.2 });
	const boost = ABILITY_BOOSTS[plan.id]?.(move) || 1;
	const alwaysHits = plan.id === 'noguard';
	if (boost === 1 && !alwaysHits) return move;
	return wrap({ abilityBoost: boost, alwaysHits });
}

function movesFor(species, isDoubles, plan) {
	const oneHP = species.maxHP === 1;
	const pool = [...Dex.species.getMovePool(species.id)].map(id => Dex.moves.get(id))
		.filter(move => move.exists && !move.isNonstandard && !move.isZ && !move.isMax &&
			(!BAD_MOVES.has(move.id) || (COUNTER_MOVES.includes(move.id) && wantsCounterMoves(species))) &&
			(!LOCK_IN_MOVES.includes(move.id) || species.types.includes(move.type)) &&
			// with 1 HP, any move that costs HP is a move that knocks you out
			!(oneHP && (costsHP(move) || (move.heal && move.category === 'Status') ||
				['rest', 'trick', 'switcheroo'].includes(move.id))))
		.map(move => asUsedBy(move, plan));
	let { atk, spa } = battleStats(species);
	if (plan && ATTACK_DOUBLERS.includes(plan.id)) atk *= 2;
	// Commit to one attacking category. Mixing physical and special attacks is what let
	// a four-move draw come out as Swords Dance alongside Ice Beam: the setup move and
	// the attacks have to agree or half the set is dead weight.
	let category = CATEGORY_OVERRIDES[species.id] || CATEGORY_OVERRIDES[megaBaseOf(species)?.id];
	if (!category) {
		if (atk > spa + 10) {
			category = 'Physical';
		} else if (spa > atk + 10) {
			category = 'Special';
		} else {
			// evenly spread stats: go with whichever side it actually has the moves for
			const strength = cat => pool.filter(m => m.category === cat && m.basePower >= 60)
				.sort((a, b) => moveScore(b) - moveScore(a)).slice(0, 4)
				.reduce((total, m) => total + moveScore(m), 0);
			category = strength('Physical') >= strength('Special') ? 'Physical' : 'Special';
		}
	}
	if (plan && ATTACK_DOUBLERS.includes(plan.id)) category = 'Physical';
	const offStat = category === 'Physical' ? spa : atk;
	const mainStat = category === 'Physical' ? atk : spa;
	const byScore = (a, b) => moveScore(b, species, isDoubles) - moveScore(a, species, isDoubles);
	// (a 1-HP Pokemon prefers attacks that don't drain: there's nothing for it to heal)
	const drainPenalty = m => (oneHP && m.drain ? 0.9 : 1);
	const attacks = pool.filter(m => m.category === category && m.basePower >= 55)
		.sort((a, b) => moveScore(b, species, isDoubles) * drainPenalty(b) - moveScore(a, species, isDoubles) * drainPenalty(a));
	// when a type has no attack on the Pokemon's own side, the other side will do for its
	// STAB, provided it can hit reasonably hard with it
	const offAttacks = offStat >= Math.min(90, mainStat * 0.75) ?
		pool.filter(m => m.category !== category && m.category !== 'Status' && m.basePower >= 55).sort(byScore) : [];
	return { pool, attacks, offAttacks, category };
}

/**
 * What kind of Pokemon this is, decided from its stats alone. Working this out first
 * is what keeps a set coherent: the archetype says how many slots go to attacks,
 * setup, recovery and support, instead of bolting one of each onto every Pokemon.
 */
function archetypeFor(species) {
	// Wonder Guard is its only defence, so it attacks, sets up and spreads status
	if (species.maxHP === 1) return 'wonder guard';
	const { hp, atk, def, spa, spd, spe } = battleStats(species);
	const offense = Math.max(atk, spa);
	const bulk = hp + def + spd;
	if (spe >= 95 && offense >= 95) return 'sweeper';
	if (offense >= 110) return 'wallbreaker';
	if (bulk >= 280 && offense >= 85) return 'bulky attacker';
	if (bulk >= 280) return 'bulky support';
	if (spe >= 95) return 'fast support';
	return 'bulky attacker';
}

/** how many of each kind of move each archetype wants */
const QUOTAS = {
	'sweeper': { attacks: 4, setup: 2, recovery: 0, utility: 1, pivot: 0, hazards: 0 },
	'wallbreaker': { attacks: 4, setup: 1, recovery: 1, utility: 1, pivot: 1, hazards: 0 },
	'bulky attacker': { attacks: 3, setup: 1, recovery: 1, utility: 1, pivot: 1, hazards: 1 },
	'bulky support': { attacks: 2, setup: 0, recovery: 1, utility: 3, pivot: 1, hazards: 1 },
	'fast support': { attacks: 3, setup: 0, recovery: 1, utility: 2, pivot: 1, hazards: 1 },
	'wonder guard': { attacks: 3, setup: 1, recovery: 0, utility: 2, pivot: 0, hazards: 0 },
	// Gorilla Tactics locks it into one move like a Choice item, so status moves are wasted
	'choice locked': { attacks: 5, setup: 0, recovery: 0, utility: 0, pivot: 1, hazards: 0 },
};

/** the move this Pokemon can't do without, if every ability it could get depends on one */
/** weather abilities a Mega should bring the weather for (Sand Force and the like are a bonus, not the point) */
const MEGA_WEATHER_ABILITIES = ['swiftswim', 'chlorophyll', 'solarpower', 'sandrush', 'slushrush'];

function requiredMoveFor(species, pool) {
	let abilities = abilitiesFor(megaBaseOf(species) || species).map(name => Dex.toID(name));
	if (megaBaseOf(species)) {
		const own = Object.values(species.abilities).map(name => Dex.toID(name));
		if (own.every(id => MEGA_WEATHER_ABILITIES.includes(id))) abilities = own;
	}
	const needs = new Set(abilities.map(id => ABILITY_NEEDS[id]));
	if (needs.size !== 1 || needs.has(undefined)) return null;
	const [moveid] = needs;
	return pool.some(m => m.id === moveid) ? Dex.moves.get(moveid) : null;
}

const isAttack = name => Dex.moves.get(name).category !== 'Status';

function buildMovepool(species, isDoubles) {
	const plan = abilityPlanFor(species);
	const { pool, attacks, offAttacks, category } = movesFor(species, isDoubles, plan);
	const archetype = plan?.id === 'gorillatactics' ? 'choice locked' : archetypeFor(species);
	const quota = { ...QUOTAS[archetype] };
	const prankster = plan?.id === 'prankster';
	if (prankster) quota.utility = Math.max(quota.utility, 2);
	const has = id => pool.some(m => m.id === id);
	const chosen = [];
	const add = move => {
		if (move && !chosen.includes(move.name) && chosen.length < 9) chosen.push(move.name);
	};
	const pick = preferred => preferred.filter(id => has(id)).map(id => Dex.moves.get(id).name);

	const offensiveSetup = pick([...(category === 'Physical' ? SETUP_PHYSICAL : SETUP_SPECIAL), ...SETUP_NEUTRAL]);
	const speedSetup = pick(SETUP_SPEED);
	// One boosting move, plus a speed boost only for something that isn't already fast:
	// a sweeper with Nasty Plot, Agility and Substitute ends up with one attack to its name
	const setup = [];
	// with Contrary, a boosting move lowers the stat instead, and the self-dropping attacks are the boost
	if (quota.setup && plan?.id !== 'contrary') {
		setup.push(...(offensiveSetup.length ? offensiveSetup : plan?.id === 'speedboost' ? [] : speedSetup).slice(0, 1));
		if (quota.setup >= 2 && offensiveSetup.length && battleStats(species).spe < 100 && plan?.id !== 'speedboost') {
			setup.push(...speedSetup.slice(0, 1));
		}
	}
	// a boosting set is wasted on attacks that lower the very stat it just raised
	const fitsSet = move => !setup.length || !selfDrop(move);
	const best = list => list.find(fitsSet) || list[0];

	// A Pokemon whose ability needs a weather or terrain always brings it, and the
	// same goes for a move its ability depends on (Protect for Speed Boost, and so on)
	add(requiredMoveFor(species, pool));
	if (plan && ABILITY_MOVES[plan.id] && has(ABILITY_MOVES[plan.id])) add(Dex.moves.get(ABILITY_MOVES[plan.id]));
	// a priority STAB is the best thing a 1-HP Pokemon can have: it hits before it can be hit
	if (species.maxHP === 1) {
		add(pool.find(m => m.priority > 0 && m.category !== 'Status' && species.types.includes(m.type)));
	}

	// One attack of every type the Pokemon has, before anything else
	for (const type of species.types) {
		const ofType = list => list.filter(m => m.type === type && !NO_STAB.has(m.id));
		add(best(ofType(attacks)) || best(ofType(offAttacks)));
	}
	const attackTypes = new Set(chosen.filter(isAttack).map(name => Dex.moves.get(name).type));
	// Then coverage: each pick is whichever type fixes the most of what the set can't hit yet
	while (chosen.filter(isAttack).length < quota.attacks) {
		let bestMove = null, bestGain = 0;
		const current = coverageScore(attackTypes);
		for (const type of TYPES) {
			if (attackTypes.has(type)) continue;
			const move = best(attacks.filter(m => m.type === type));
			// a weak move is a wasted slot, however many types it touches
			if (!move || moveScore(move, species) < 70) continue;
			// what the move fixes, scaled by how hard it hits: Aerial Ace "covers" Bug, but
			// barely, so it shouldn't beat a strong move that fixes almost as much
			const gain = (coverageScore([...attackTypes, type]) - current) * Math.min(1, moveScore(move, species, isDoubles) / 90);
			if (gain > bestGain) {
				bestGain = gain;
				bestMove = move;
			}
		}
		if (!bestMove || bestGain < 1) break;
		attackTypes.add(bestMove.type);
		add(bestMove);
	}
	// top up so a four-move draw can't come out as one attack and three status moves
	for (const move of attacks.filter(fitsSet)) {
		if (chosen.filter(isAttack).length >= Math.min(quota.attacks, 3)) break;
		add(move);
	}
	const attackCount = chosen.filter(isAttack).length;

	// Rest only belongs on something bulky enough to sleep through a few hits
	const bulky = archetype.startsWith('bulky') || archetype === 'fast support';
	const recovery = pick(RECOVERY_MOVES.filter(id => id !== 'rest' || bulky));
	const pivot = pick(PIVOT_MOVES);
	// a bulky attacker that found setup gets labelled a sweeper too, so judge by what
	// the set will actually be rather than by the archetype alone
	const willSweep = archetype === 'sweeper' ||
		(archetype === 'bulky attacker' && setup.length && battleStats(species).spe >= 85);
	const utilityList = prankster ? PRANKSTER_MOVES : willSweep ? SWEEPER_UTILITY : UTILITY_MOVES;
	const utility = pick(wantsCounterMoves(species) ? [...COUNTER_MOVES, ...utilityList] : utilityList);
	const hazards = pick(HAZARD_MOVES);

	if (isDoubles) {
		if (has('protect')) add(Dex.moves.get('protect'));
		for (const name of pick(DOUBLES_MOVES).slice(0, 2)) add(Dex.moves.get(name));
	}
	for (const name of setup) add(Dex.moves.get(name));
	// Rest is fine on its own here: Showdown gives it a Chesto Berry, and pairs it
	// with Sleep Talk when the Pokemon has one
	if (quota.recovery && has('sleeptalk') && recovery.includes('Rest')) add(Dex.moves.get('sleeptalk'));
	for (const name of recovery.slice(0, quota.recovery)) add(Dex.moves.get(name));
	for (const name of pivot.slice(0, quota.pivot)) add(Dex.moves.get(name));
	for (const name of hazards.slice(0, quota.hazards)) add(Dex.moves.get(name));
	for (const name of utility.slice(0, quota.utility)) add(Dex.moves.get(name));
	// Showdown picks four moves, so make sure there are at least four to pick from
	for (const name of [...utility, ...pick(UTILITY_MOVES), ...pick(HAZARD_MOVES)]) {
		if (chosen.length >= 4) break;
		add(Dex.moves.get(name));
	}

	return {
		movepool: chosen, attackCount, category, archetype, plan,
		hasSetup: chosen.some(n => setup.includes(n)),
		hasRecovery: chosen.some(n => recovery.includes(n)),
		hasProtect: has('protect'),
	};
}

function roleFor(species, info, isDoubles) {
	const { atk, def, spa, spd, hp, spe } = battleStats(species);
	const offense = Math.max(atk, spa);
	const bulk = hp + def + spd;
	if (isDoubles) {
		if (info.hasProtect && offense >= 100) return 'Offensive Protect';
		if (info.hasProtect && bulk >= 270) return 'Bulky Protect';
		if (spe >= 95 && offense >= 95) return 'Doubles Fast Attacker';
		if (bulk >= 260 && offense >= 85) return 'Doubles Bulky Attacker';
		if (info.hasSetup) return 'Doubles Setup Sweeper';
		if (offense >= 110) return 'Doubles Wallbreaker';
		return 'Doubles Support';
	}
	switch (info.archetype) {
	case 'wonder guard': return 'Setup Sweeper';
	case 'choice locked': return 'Wallbreaker';
	case 'sweeper': return info.hasSetup ? 'Setup Sweeper' : 'Fast Attacker';
	case 'wallbreaker': return 'Wallbreaker';
	case 'bulky attacker': return info.hasSetup && spe >= 85 ? 'Setup Sweeper' : 'Bulky Attacker';
	case 'fast support': return 'Fast Support';
	default: return 'Bulky Support';
	}
}

function abilitiesFor(species) {
	const abilities = Object.values(species.abilities)
		.filter(name => name && !BAD_ABILITIES.has(Dex.toID(name)));
	return abilities.length ? abilities : [Object.values(species.abilities)[0]];
}

function generate(species, isDoubles) {
	const hand = HAND_SETS[species.id];
	if (hand) {
		const movepool = [...hand.movepool];
		if (isDoubles && Dex.species.getMovePool(species.id).has('protect')) movepool.push('Protect');
		return {
			role: isDoubles ? 'Doubles Support' : hand.role,
			movepool: movepool.sort(),
			abilities: hand.abilities,
			teraTypes: [...new Set(species.types)],
		};
	}
	const info = buildMovepool(species, isDoubles);
	// Showdown picks four moves from this pool, so anything that can't fill four
	// (Wobbuffet, whose only attacks are Counter and Mirror Coat) is left out entirely
	if (info.movepool.length < 4) return null;
	// A Mega starts the battle in its base forme, so it carries the base forme's ability
	const abilitySource = megaBaseOf(species) || species;
	let abilities = abilitiesFor(abilitySource);
	// a set built around an ability keeps only that ability, so the team builder can't swap
	// it for another; Contrary is dropped from any set not built around it, where it would
	// only turn the set's boosting moves against it
	if (info.plan && !info.plan.fixed) abilities = [info.plan.name];
	else if (abilities.length > 1) abilities = abilities.filter(name => name !== 'Contrary');
	return {
		role: roleFor(species, info, isDoubles),
		movepool: info.movepool.sort(),
		abilities,
		teraTypes: [...new Set(species.types)],
	};
}

function build(file, isDoubles) {
	const filePath = path.join(DATA_DIR, file);
	const data = JSON.parse(fs.readFileSync(filePath, 'utf8'));
	let added = 0, rebuilt = 0, skipped = 0;

	// Showdown's own sets are fully evolved Pokemon (plus a handful of Eviolite
	// users it picked by hand), so generated ones follow the same rule: a Random
	// Battle full of Caterpies isn't much of a battle.
	// Totem and costume formes are near-duplicates of the ordinary Pokemon, so
	// leaving them in would just mean seeing the same Pokemon twice as often
	const DUPLICATE_FORMES = /-(Totem|Cosplay|Belle|Libre|PhD|Pop-Star|Rock-Star|Spiky-eared|Starter)/i;
	const eligible = species => {
		if (!species.exists || species.isNonstandard) return false;
		if (species.forme === 'Gmax' || DUPLICATE_FORMES.test(species.name)) return false;
		if (!Dex.species.getMovePool(species.id).size) return false;
		// Megas get a set of their own, built around the Mega's stats and typing, the
		// way Showdown does it in Gen 6 and 7. The team still holds the base Pokemon;
		// the stone comes along with it, so it Mega Evolves in battle.
		if (isMega(species)) return eligible(megaBaseOf(species));
		if (species.isMega || species.battleOnly) return false;
		return !species.evos?.length || STILL_EVOLVING.includes(species.id);
	};

	// Formes that only look different (Minior's cores, Vivillon's patterns, Pikachu's caps)
	// would each get a set of their own and crowd the pool with one Pokemon. Only one of
	// each look-alike group keeps a set; Showdown still picks a random look for it in
	// battle (getForme). One already in Showdown's own data is preferred, then the base forme.
	const battleKey = species => [
		species.isMega, species.types, Object.values(species.baseStats), Object.values(species.abilities).sort(),
		species.requiredItem || '',
	].join('|');
	const keepers = new Map();
	for (const species of Dex.species.all()) {
		if (!eligible(species)) continue;
		const key = species.baseSpecies + '|' + battleKey(species);
		const current = keepers.get(key);
		const rank = s => (data[s.id] && !data[s.id].generated ? 0 : 2) + ((megaBaseOf(s) || s).forme ? 1 : 0);
		if (!current || rank(species) < rank(current)) keepers.set(key, species);
	}
	const isLookalike = species => keepers.get(species.baseSpecies + '|' + battleKey(species)) !== species;
	const usable = species => eligible(species) && !isLookalike(species);

	// drop generated sets for anything that no longer qualifies
	let lookalikes = 0;
	for (const id of Object.keys(data)) {
		const species = Dex.species.get(id);
		if (!data[id]?.generated || usable(species)) continue;
		if (eligible(species)) lookalikes++;
		delete data[id];
	}

	for (const species of Dex.species.all()) {
		if (!usable(species)) continue;
		const existing = data[species.id];
		if (existing && !(FORCE && existing.generated)) continue;

		const set = generate(species, isDoubles);
		if (!set) {
			// drop any entry we wrote for it previously, or a stale one keeps it in the pool
			if (existing?.generated) delete data[species.id];
			skipped++;
			continue;
		}
		if (existing) rebuilt++; else added++;
		data[species.id] = { level: levelFor(species), sets: [set], generated: true };
	}

	// keep the file in species order, like the originals
	const ordered = {};
	for (const id of Object.keys(data).sort((a, b) => (Dex.species.get(a).num - Dex.species.get(b).num) || a.localeCompare(b))) {
		ordered[id] = data[id];
	}
	fs.writeFileSync(filePath, JSON.stringify(ordered, null, '\t') + '\n');
	console.log(`${file}: ${added} added, ${rebuilt} rebuilt, ${skipped} skipped (no usable moves), ` +
		`${lookalikes} look-alike formes removed, ${Object.keys(ordered).length} total`);
}

build('sets.json', false);
build('doubles-sets.json', true);
