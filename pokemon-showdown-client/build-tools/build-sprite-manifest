#!/usr/bin/env node
/**
 * Lists the sprites this server has of its own, so the client knows which ones to
 * load from here instead of from play.pokemonshowdown.com.
 *
 * The client can't look at the filesystem, and the sprite folders hold both this
 * game's Pokemon and its own artwork for the official ones, so the choice can't be
 * a fixed list any more: it's whatever is actually on disk when the client is built.
 *
 * Re-run this (or just `node build`) after adding or removing sprite files.
 */
'use strict';

const fs = require('fs');
const path = require('path');
process.chdir(path.resolve(__dirname, '../play.pokemonshowdown.com'));

process.stdout.write('Listing our own sprites... ');

const SPRITES = 'sprites';
const manifest = {};
let total = 0;
for (const entry of fs.readdirSync(SPRITES, {withFileTypes: true})) {
	if (!entry.isDirectory()) continue;
	const names = fs.readdirSync(path.join(SPRITES, entry.name))
		.filter(f => f.toLowerCase().endsWith('.png'))
		.map(f => f.slice(0, -4))
		.sort();
	if (!names.length) continue;
	manifest[entry.name] = names.join(' ');
	total += names.length;
}

fs.writeFileSync('data/local-sprites.js', `/*
DO NOT EDIT

THIS FILE IS AUTOGENERATED BY ./build-tools/build-sprite-manifest
*/

exports.BattleLocalSprites = ${JSON.stringify(manifest, null, 1)};
`);
console.log(`DONE (${total} files in ${Object.keys(manifest).length} folders)`);
